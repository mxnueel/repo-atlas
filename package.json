{
  "name": "repo-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Instant visual treemap of any public GitHub repository's codebase — paste a URL, see where the code lives, what languages dominate. No account, no server, static site.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/treemap.test.js tests/github.test.js tests/e2e.test.js",
    "test:unit": "node --test tests/treemap.test.js tests/github.test.js",
    "test:e2e": "node --test tests/e2e.test.js"
  },
  "keywords": [
    "github",
    "treemap",
    "data-visualization",
    "codebase",
    "architecture",
    "d3",
    "static-site"
  ],
  "author": "Manuel Bautista",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxnueel/repo-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/mxnueel/repo-atlas/issues"
  },
  "homepage": "https://mxnueel.github.io/repo-atlas/",
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
